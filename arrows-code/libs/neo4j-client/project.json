{
  "name": "arrows-code-neo4j-client",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "arrows-code/libs/neo4j-client/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/arrows-code/libs/neo4j-client",
        "main": "arrows-code/libs/neo4j-client/src/index.ts",
        "tsConfig": "arrows-code/libs/neo4j-client/tsconfig.lib.json",
        "assets": ["arrows-code/libs/neo4j-client/*.md"],
        "generatePackageJson": true
      }
    },
    "lint": {
      "executor": "@nx/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["arrows-code/libs/neo4j-client/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["coverage/arrows-code/libs/neo4j-client"],
      "options": {
        "passWithNoTests": true,
        "reportsDirectory": "../../../coverage/arrows-code/libs/neo4j-client"
      }
    }
  },
  "tags": ["scope:arrows-code", "type:lib"]
}
