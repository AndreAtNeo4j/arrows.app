<idea-plugin>
    <id>app.arrows.intellij</id>
    <name>Arrows</name>
    <vendor url="https://neo4j.com/labs/arrows">Neo4j Labs</vendor>
    <description>Edit Neo4j graph models visually in .arrows files, the JVM counterpart to the VS Code extension.</description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="Arrows"
            implementationClass="app.arrows.intellij.ArrowsFileType"
            fieldName="INSTANCE"
            extensions="arrows"/>
        <fileEditorProvider implementation="app.arrows.intellij.ArrowsFileEditorProvider"/>
        <toolWindow id="Arrows" anchor="left" icon="/icons/arrows.svg" factoryClass="app.arrows.intellij.ArrowsToolWindowFactory"/>
    </extensions>
</idea-plugin>
