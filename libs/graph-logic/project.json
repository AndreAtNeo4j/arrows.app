{
  "name": "graph-logic",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/graph-logic/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/graph-logic",
        "main": "libs/graph-logic/src/index.ts",
        "tsConfig": "libs/graph-logic/tsconfig.lib.json",
        "assets": ["libs/graph-logic/*.md"],
        "generatePackageJson": true
      }
    },
    "lint": {
      "executor": "@nx/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/graph-logic/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["coverage/libs/graph-logic"],
      "options": {
        "passWithNoTests": true,
        "reportsDirectory": "../../coverage/libs/graph-logic"
      }
    }
  },
  "tags": []
}
